rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ cho phép đúng 1 document trạng thái "nuôi vé" của app.
    match /mega645/data {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['rawData', 'currentDay', 'lockedMatrix'])
        && request.resource.data.currentDay is int
        && request.resource.data.currentDay >= 1
        && request.resource.data.currentDay <= 7
        && (request.resource.data.lockedMatrix == null
            || (request.resource.data.lockedMatrix is list
                && request.resource.data.lockedMatrix.size() <= 50));
      allow delete: if false;
    }
    // Mọi document khác: chặn hoàn toàn.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
